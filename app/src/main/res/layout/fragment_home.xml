<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/label_clima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clima"
            android:textSize="24sp"
            android:textColor="#000000"
            android:layout_gravity="center"/>

        <EditText
            android:id="@+id/codigo_iso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código ISO del País"
            android:inputType="text"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:minHeight="48dp"
            android:background="@drawable/rounded_edittext_bg"/>

        <EditText
            android:id="@+id/ciudad_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de Ciudad"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:minHeight="48dp"
            android:background="@drawable/rounded_edittext_bg"/>

        <Button
            android:id="@+id/obtener_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBTENER"
            android:backgroundTint="#9C27B0"
            android:textColor="#ffffff"
            android:layout_marginTop="16dp"
            android:padding="12dp"/>

        <TextView
            android:id="@+id/label_temperatura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperatura (API del Clima)"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginTop="24dp"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/temperatura_actual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actual: N/A"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/temperatura_minima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mínima: N/A"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/temperatura_maxima"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máxima: N/A"
            android:textColor="#000000"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>