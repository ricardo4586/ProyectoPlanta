<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".fragments.TemperatureFragment">

    <TextView
        android:id="@+id/tvTemperaturaAmbiental"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temperatura Ambiental: N/D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChartTemperaturaAmbiental"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvTemperaturaSuelo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temperatura del Suelo: N/D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChartTemperaturaSuelo"
        android:layout_width="match_parent"
        android:layout_height="200dp"/>

</LinearLayout>