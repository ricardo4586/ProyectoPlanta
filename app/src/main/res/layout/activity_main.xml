<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:id="@+id/label_clima"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clima"
        android:textSize="24sp"
        android:textColor="#000000"
        android:layout_gravity="center"/>

    <!-- Campo Código ISO -->
    <EditText
        android:id="@+id/codigo_iso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código ISO del País"
        android:inputType="text"
        android:layout_marginTop="16dp"
        android:padding="12dp"/>

    <!-- Campo Nombre de Ciudad -->
    <EditText
        android:id="@+id/ciudad_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de Ciudad"
        android:inputType="text"
        android:layout_marginTop="8dp"
        android:padding="12dp"/>

    <!-- Botón Obtener -->
    <Button
        android:id="@+id/obtener_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OBTENER"
        android:backgroundTint="#9C27B0"
        android:textColor="#ffffff"
        android:layout_marginTop="16dp"
        android:padding="12dp"/>

    <!-- Sección de Temperatura -->
    <TextView
        android:id="@+id/label_temperatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temperatura"
        android:textSize="20sp"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        android:layout_gravity="center"/>

    <!-- Temperatura Actual -->
    <TextView
        android:id="@+id/temperatura_actual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actual: 18.52°C"
        android:textColor="#000000"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

    <!-- Temperatura Mínima -->
    <TextView
        android:id="@+id/temperatura_minima"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mínima: 18.37°C"
        android:textColor="#000000"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

    <!-- Temperatura Máxima -->
    <TextView
        android:id="@+id/temperatura_maxima"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Máxima: 18.52°C"
        android:textColor="#000000"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
