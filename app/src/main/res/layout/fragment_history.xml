<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".fragments.HistoryFragment">

    <TextView
        android:id="@+id/tv_history_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Historial de Datos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_sensor_type_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar Sensor:"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_history_title"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinner_sensor_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:entries="@array/sensor_types_array"
        android:minHeight="48dp"
        app:layout_constraintTop_toTopOf="@+id/tv_sensor_type_label"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sensor_type_label"
        app:layout_constraintStart_toEndOf="@+id/tv_sensor_type_label"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_date_range_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rango de Tiempo:"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/spinner_sensor_type"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layout_date_range_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_date_range_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_last_24_hours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="24h"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_last_7_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="7D"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_last_30_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="30D"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_custom_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Personalizar"
            android:textSize="12sp"
            android:padding="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_selected_date_range"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rango actual: Últimas 24 horas"
        android:textSize="14sp"
        android:gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_date_range_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/history_line_chart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_selected_date_range"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/history_line_chart"
        app:layout_constraintBottom_toBottomOf="@id/history_line_chart"
        app:layout_constraintStart_toStartOf="@id/history_line_chart"
        app:layout_constraintEnd_toEndOf="@id/history_line_chart"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_no_data_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay datos disponibles para el rango seleccionado."
        android:visibility="gone"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="@id/history_line_chart"
        app:layout_constraintBottom_toBottomOf="@id/history_line_chart"
        app:layout_constraintStart_toStartOf="@id/history_line_chart"
        app:layout_constraintEnd_toEndOf="@id/history_line_chart"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>