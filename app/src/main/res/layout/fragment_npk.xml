<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.NPKFragment">

    <TextView
        android:id="@+id/tv_nitrogeno_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nitrógeno:"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_nitrogeno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="N/D"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_nitrogeno_label"
        app:layout_constraintTop_toTopOf="@id/tv_nitrogeno_label" />

    <TextView
        android:id="@+id/tv_fosforo_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fósforo:"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_nitrogeno_label" />

    <TextView
        android:id="@+id/tv_fosforo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="N/D"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_fosforo_label"
        app:layout_constraintTop_toTopOf="@id/tv_fosforo_label" />

    <TextView
        android:id="@+id/tv_potasio_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Potasio:"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_fosforo_label" />

    <TextView
        android:id="@+id/tv_potasio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="N/D"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_potasio_label"
        app:layout_constraintTop_toTopOf="@id/tv_potasio_label" />

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/npk_line_chart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_potasio_label" />

</androidx.constraintlayout.widget.ConstraintLayout>